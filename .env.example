# Local development only. Copy this file to .env and do not commit .env.
NODE_ENV=development
LOG_LEVEL=info
# Set false to pause all process-local background automations while debugging.
JOBS_ENABLED=true

DATABASE_URL=postgresql://clearledger:clearledger_dev_only@localhost:5432/clearledger?schema=public
TEST_DATABASE_URL=postgresql://clearledger:clearledger_dev_only@localhost:5433/clearledger_test?schema=public
REDIS_URL=redis://localhost:6379

APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
PAYMENT_PUBLIC_BASE_URL=http://localhost:3000

# Optional Stripe test-mode adapter. Keep secrets blank unless using Stripe-hosted Checkout.
# STRIPE_MODE selects the adapter. Leave it commented out unless you are also
# setting STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET and
# PAYMENT_ACCOUNT_ENCRYPTION_SECRET - naming the mode alone arms the Stripe
# gate and the API refuses to start.
# STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_ACCOUNT_ENCRYPTION_SECRET=
# Select PAYPAL only when the complete PayPal partner configuration is present.
# PayPal's partner attribution ID is the BN value assigned to your application.
# PAYMENT_PROVIDER=PAYPAL
# PAYPAL_MODE=test
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=
PAYPAL_WEBHOOK_ID=
WEBHOOK_SECRET_ENCRYPTION_SECRET=
CONNECTOR_CREDENTIAL_ENCRYPTION_SECRET=
# Customer email is opt-in. `smtp` lets each organization configure its own
# encrypted relay in the Integrations workspace; no Gmail/Microsoft OAuth app
# registration is required. The password is entered in the UI, not here.
# Leave delivery disabled unless you intend to send the confirmation test email.
EMAIL_DELIVERY_MODE=disabled
EMAIL_CONNECTION_ENCRYPTION_SECRET=
PENNYWISE_BETA_EMAIL_DELIVERY_APPROVED=false
# Optional OAuth alternatives when EMAIL_DELIVERY_MODE=connected-mailbox.
EMAIL_GMAIL_CLIENT_ID=
EMAIL_GMAIL_CLIENT_SECRET=
EMAIL_GMAIL_REDIRECT_URI=
EMAIL_MICROSOFT_CLIENT_ID=
EMAIL_MICROSOFT_CLIENT_SECRET=
EMAIL_MICROSOFT_TENANT_ID=
EMAIL_MICROSOFT_REDIRECT_URI=
# Separate public origin for WooCommerce and Etsy webhook delivery. Required in
# production; optional for local polling-only development. It must be an HTTPS
# origin only: no credentials, path, query, or fragment.
CONNECTOR_WEBHOOK_BASE_URL=

# Bank feeds are optional. For local UI/integration testing, explicitly opt in
# to PennyWise's synthetic provider; it never connects to a financial institution.
BANK_FEED_PROVIDER=
PENNYWISE_ENABLE_TEST_BANK=false
PENNYWISE_BETA_BANK_FEEDS_SANDBOX_APPROVED=false
# For a real provider in a non-production environment only; never commit values.
# PLAID_ENV alone arms the bank-feed gate, which then fails because
# BANK_FEED_PROVIDER is unset. Uncomment it together with BANK_FEED_PROVIDER=PLAID,
# PLAID_CLIENT_ID and PLAID_SECRET, or set BANK_FEED_PROVIDER=FLINKS with all
# of the FLINKS_* values below. Flinks Connect keeps online-banking credentials
# inside the provider-hosted secure window; PennyWise receives only its loginId.
# PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# FLINKS_ENV=sandbox
# FLINKS_INSTANCE=toolbox
FLINKS_CUSTOMER_ID=
FLINKS_SECRET_KEY=
FLINKS_API_KEY=
# Optional HTTPS origins for nonstandard Flinks staging instances.
FLINKS_API_BASE_URL=
FLINKS_IFRAME_BASE_URL=
BANK_FEED_PRODUCTION_APPROVED=false

# Production OIDC placeholders. Replace through the deployment secrets manager.
OIDC_ISSUER=https://identity.example.invalid
OIDC_CLIENT_ID=clearledger-development-placeholder
OIDC_CLIENT_SECRET=development-placeholder-not-a-secret
OIDC_REDIRECT_URI=http://localhost:3001/v1/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000
OIDC_RECOVERY_URL=https://identity.example.invalid/recover

# Production adapters are injected by deployment code; never fall back to the
# local in-memory storage, scanner, mail, payment, or rate-limit adapters.
