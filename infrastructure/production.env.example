# Deployment secret-manager contract. Never commit real values.
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL=postgresql://runtime-user:replace-me@managed-postgres.example/clearledger?sslmode=require
REDIS_URL=rediss://replace-me@managed-redis.example:6380
APP_BASE_URL=https://app.example.ca
API_BASE_URL=https://api.example.ca
PAYMENT_PUBLIC_BASE_URL=https://app.example.ca
OIDC_ISSUER=https://identity.example.ca
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URI=https://api.example.ca/v1/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://app.example.ca
OIDC_RECOVERY_URL=https://identity.example.ca/recover
STRIPE_MODE=live
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
PAYMENT_ACCOUNT_ENCRYPTION_SECRET=replace-me
WEBHOOK_SECRET_ENCRYPTION_SECRET=replace-me
CONNECTOR_CREDENTIAL_ENCRYPTION_SECRET=replace-me
PRODUCT_ANALYTICS_INTERNAL_KEY=replace-me

# Bank feeds remain disabled unless the deployment owner explicitly enables a
# live provider. Never select PENNYWISE_TEST_BANK or set its test opt-in here.
# When enabled, this must be the approved live Plaid environment.
BANK_FEED_PROVIDER=PLAID
PLAID_ENV=production
PLAID_CLIENT_ID=replace-me
PLAID_SECRET=replace-me
BANK_FEED_PRODUCTION_APPROVED=false

# Non-secret deployment evidence. Set only after the corresponding owner has
# validated the real managed adapters and operational controls.
PRODUCTION_ADAPTERS_READY=false
PRODUCTION_DATA_REGION=ca-central-1
BACKUP_RESTORE_DRILL_AT=replace-with-iso-timestamp
SECURITY_REVIEW_AT=replace-with-iso-timestamp
LEGAL_PRIVACY_REVIEW_AT=replace-with-iso-timestamp
