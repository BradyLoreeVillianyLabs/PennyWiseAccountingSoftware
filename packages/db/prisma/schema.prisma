  accounts                 Account[]
  periods                  FiscalPeriod[]
  journals                 Journal[]
  journalLines             JournalLine[]
  products                 ProductItem[]
  productBarcodes          ProductBarcode[]
  inventoryLabelTemplates  InventoryLabelTemplate[]
  inventoryLocations       InventoryLocation[]
  inventoryBalances        InventoryBalance[]
  inventoryMovements       InventoryMovement[]
  inventoryBins            InventoryBin[]
  inventoryStatuses        InventoryStatus[]
  inventoryLots            InventoryLot[]
  inventorySerials         InventorySerial[]
  inventoryReservations    InventoryReservation[]
  inventoryTransfers       InventoryTransfer[]
  inventoryTransferLines   InventoryTransferLine[]
  inventoryCounts          InventoryCount[]
  inventoryCountLines      InventoryCountLine[]
