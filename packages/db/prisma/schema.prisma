model User {
  id                             String                     @id @default(uuid()) @db.Uuid
  email                          String                     @unique
  displayName                    String?
  emailVerifiedAt                DateTime?                  @db.Timestamptz(6)
  status                         UserStatus                 @default(ACTIVE)
  createdAt                      DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                      DateTime                   @updatedAt
  memberships                    Membership[]               @relation("MembershipUser")
  companyMemberships             CompanyMembership[]        @relation("CompanyMembershipUser")
  createdCompanies               Company[]                  @relation("CompanyCreator")
  revokedMemberships             Membership[]               @relation("MembershipRevoker")
  identities                     ExternalIdentity[]
  sessions                       Session[]
  acceptedInvitations            OrganizationInvitation[]   @relation("InvitationAcceptor")
  revokedInvitations             OrganizationInvitation[]   @relation("InvitationRevoker")
  createdInvitations             OrganizationInvitation[]   @relation("InvitationCreator")
  auditEvents                    AuditEvent[]               @relation("AuditActor")
  authenticationEvents           AuthenticationAuditEvent[] @relation("AuthenticationActor")
  targetedAuthenticationEvents   AuthenticationAuditEvent[] @relation("AuthenticationTarget")
  createdApiCredentials          ApiCredential[]            @relation("ApiCredentialCreator")
  createdWebhookEndpoints        WebhookEndpoint[]          @relation("WebhookEndpointCreator")
  createdOAuthClients            OAuthClient[]              @relation("OAuthClientCreator")
  createdConnectorInstallations  ConnectorInstallation[]    @relation("ConnectorInstallationCreator")
  resolvedConnectorConflicts     ConnectorConflict[]        @relation("ConnectorConflictResolver")
  catalogMatchDecisions          CatalogMatchDecision[]     @relation("CatalogMatchDecisionActor")
  resolvedCatalogMatches         CatalogMatchCandidate[]    @relation("CatalogMatchResolver")
  createdInventorySyncPolicies   InventorySyncPolicy[]      @relation("InventorySyncPolicyCreator")
  updatedInventorySyncPolicies   InventorySyncPolicy[]      @relation("InventorySyncPolicyUpdater")
  resolvedInventorySyncConflicts InventorySyncConflict[]    @relation("InventorySyncConflictResolver")
  oauthAuthorizationCodes        OAuthAuthorizationCode[]
  oauthAccessTokens              OAuthAccessToken[]
  oauthRefreshTokens             OAuthRefreshToken[]
  reportViews                    ReportView[]               @relation("ReportViewOwner")
}

