  @@unique([organizationId, id])
  @@unique([organizationId, runWorkerId])
  @@index([organizationId, createdAt])
}

model PayrollRemittance {
  id                 String                  @id @default(uuid()) @db.Uuid
  organizationId     String                  @db.Uuid
  runId              String                  @db.Uuid
  authorityCode      String
  liabilityAccountId String                  @db.Uuid
  amountMinor        BigInt
  dueDate            DateTime                @db.Date
  status             PayrollRemittanceStatus @default(OPEN)
  paidAt             DateTime?               @db.Timestamptz(6)
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run                PayrollRun              @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict)
  liabilityAccount   Account                 @relation("PayrollRemittanceAccount", fields: [organizationId, liabilityAccountId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, runId, authorityCode, liabilityAccountId])
  @@unique([organizationId, id])
  @@index([organizationId, status, dueDate])
}

model PayrollPaymentBatch {
  id                String                    @id @default(uuid()) @db.Uuid
  organizationId    String                    @db.Uuid
  runId             String                    @db.Uuid
  batchNumber       String
  status            PayrollPaymentBatchStatus @default(DRAFT)
  paymentDate       DateTime                  @db.Date
  totalMinor        BigInt
  createdByUserId   String                    @db.Uuid
  confirmedByUserId String?                   @db.Uuid
  confirmedAt       DateTime?                 @db.Timestamptz(6)
  createdAt         DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run               PayrollRun                @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict)
  items             PayrollPaymentItem[]
  exports           PayrollPaymentExport[]

  @@unique([organizationId, batchNumber])
  @@unique([organizationId, id])
  @@index([organizationId, runId, status])
}

model PayrollPaymentItem {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @db.Uuid
  batchId         String              @db.Uuid
  runWorkerId     String              @db.Uuid
  amountMinor     BigInt
  bankAccountMask String?
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batch           PayrollPaymentBatch @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Restrict)
  runWorker       PayrollRunWorker    @relation(fields: [organizationId, runWorkerId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, batchId, runWorkerId])
  @@unique([organizationId, id])
  @@index([organizationId, runWorkerId])
}

model PayrollPaymentExport {
  id                  String              @id @default(uuid()) @db.Uuid
  organizationId      String              @db.Uuid
  batchId             String              @db.Uuid
  format              String
  sequence            Int
  contentHash         String              @db.Char(64)
  encryptedStorageKey String
  exportedByUserId    String              @db.Uuid
  exportedAt          DateTime            @default(now()) @db.Timestamptz(6)
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batch               PayrollPaymentBatch @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, batchId, sequence])
  @@unique([organizationId, id])
  @@index([organizationId, exportedAt])
}

/// A tenant/company-scoped checkout register. POS uses the existing invoice,
/// tax, inventory, payment, and journal services; these records only retain
/// operational context and immutable evidence of that workflow.
model PosRegister {
  id                  String            @id @default(uuid()) @db.Uuid
  organizationId      String            @db.Uuid
  companyId           String            @db.Uuid
  inventoryLocationId String            @db.Uuid
  cashAccountId       String            @db.Uuid
  code                String
  name                String
  status              PosRegisterStatus @default(DRAFT)
  receiptPrefix       String            @default("POS")
  version             Int               @default(1)
  createdByUserId     String            @db.Uuid
  updatedByUserId     String            @db.Uuid
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryLocation   InventoryLocation @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)
  cashAccount         Account           @relation("PosRegisterCashAccount", fields: [cashAccountId], references: [id], onDelete: Restrict)
  devices             PosDevice[]
  shifts              PosShift[]
  sales               PosSale[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, companyId, status])
}

model PosDevice {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  companyId       String       @db.Uuid
  registerId      String       @db.Uuid
  deviceCode      String
  deviceKeyHash   String?      @db.Char(64)
  active          Boolean      @default(true)
  enrolledAt      DateTime     @default(now()) @db.Timestamptz(6)
  revokedAt       DateTime?    @db.Timestamptz(6)
  lastSeenAt      DateTime?    @db.Timestamptz(6)
  createdByUserId String       @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  register        PosRegister  @relation(fields: [registerId], references: [id], onDelete: Cascade)
  shifts          PosShift[]
  sales           PosSale[]

  @@unique([organizationId, deviceCode])
  @@unique([organizationId, id])
  @@index([organizationId, registerId, active])
}

model PosShift {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @db.Uuid
  companyId         String         @db.Uuid
  registerId        String         @db.Uuid
  deviceId          String?        @db.Uuid
  status            PosShiftStatus @default(OPENING_COUNT)
  businessDate      DateTime       @db.Date
  openingFloatMinor BigInt         @default(0)
  expectedCashMinor BigInt?
  countedCashMinor  BigInt?
  varianceMinor     BigInt?
  openedByUserId    String         @db.Uuid
  closedByUserId    String?        @db.Uuid
  openedAt          DateTime       @default(now()) @db.Timestamptz(6)
  closedAt          DateTime?      @db.Timestamptz(6)
  version           Int            @default(1)
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  register          PosRegister    @relation(fields: [registerId], references: [id], onDelete: Restrict)
  device            PosDevice?     @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  sales             PosSale[]
  cashEvents        PosCashEvent[]
  refundReturns     PosReturn[]    @relation("PosReturnRefundShift")

  @@unique([organizationId, id])
  @@index([organizationId, registerId, status])
  @@index([organizationId, businessDate])
}

model PosSale {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @db.Uuid
  companyId          String         @db.Uuid
  registerId         String         @db.Uuid
  deviceId           String?        @db.Uuid
  shiftId            String         @db.Uuid
  customerId         String         @db.Uuid
  invoiceId          String?        @unique @db.Uuid
  idempotencyKey     String?        @db.VarChar(200)
  requestHash        String?        @db.Char(64)
  receiptNumber      String?
  status             PosSaleStatus  @default(DRAFT)
  currency           String         @db.Char(3)
  businessDate       DateTime       @db.Date
  subtotalMinor      BigInt         @default(0)
  discountTotalMinor BigInt         @default(0)
  taxTotalMinor      BigInt         @default(0)
  grandTotalMinor    BigInt         @default(0)
  completedAt        DateTime?      @db.Timestamptz(6)
  createdByUserId    String         @db.Uuid
  updatedByUserId    String         @db.Uuid
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  register           PosRegister    @relation(fields: [registerId], references: [id], onDelete: Restrict)
  device             PosDevice?     @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  shift              PosShift       @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  customer           Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice            Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  lines              PosSaleLine[]
  tenders            PosTender[]
  cashEvents         PosCashEvent[]
  posReturns         PosReturn[]

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, receiptNumber])
  @@index([organizationId, companyId, status, businessDate])
  @@index([organizationId, shiftId, status])
}

model PosSaleLine {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  companyId        String       @db.Uuid
  saleId           String       @db.Uuid
  lineNumber       Int
  productItemId    String?      @db.Uuid
  description      String
  skuSnapshot      String?
  quantityMicros   BigInt
  unitPriceMinor   BigInt
  grossAmountMinor BigInt
  discountMinor    BigInt       @default(0)
  netAmountMinor   BigInt
  taxTotalMinor    BigInt       @default(0)
  totalMinor       BigInt
  taxCodeId        String?      @db.Uuid
  taxSnapshot      Json?
  incomeAccountId  String       @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale             PosSale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productItem      ProductItem? @relation(fields: [productItemId], references: [id], onDelete: Restrict)

  @@unique([saleId, lineNumber])
  @@unique([organizationId, id])
  @@index([organizationId, productItemId])
}

model PosTender {
  id                  String          @id @default(uuid()) @db.Uuid
  organizationId      String          @db.Uuid
  companyId           String          @db.Uuid
  saleId              String          @db.Uuid
  paymentId           String?         @unique @db.Uuid
  type                PosTenderType   @default(CASH)
  status              PosTenderStatus @default(PENDING)
  amountReceivedMinor BigInt
  appliedAmountMinor  BigInt
  changeMinor         BigInt          @default(0)
  currency            String          @db.Char(3)
  reference           String?
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale                PosSale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  payment             Payment?        @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, saleId, status])
}

model PosCashEvent {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  companyId       String           @db.Uuid
  shiftId         String           @db.Uuid
  saleId          String?          @db.Uuid
  eventType       PosCashEventType
  amountMinor     BigInt
  reason          String?
  createdByUserId String           @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shift           PosShift         @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  sale            PosSale?         @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, shiftId, createdAt])
  @@index([organizationId, saleId])
}

model PosReturn {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  companyId       String          @db.Uuid
  saleId          String          @db.Uuid
  creditNoteId    String?         @unique @db.Uuid
  refundShiftId   String?         @db.Uuid
  idempotencyKey  String          @db.VarChar(200)
  requestHash     String          @db.Char(64)
  status          PosReturnStatus @default(PENDING)
  totalMinor      BigInt          @default(0)
  reason          String
  createdByUserId String          @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale            PosSale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  creditNote      CreditNote?     @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  refundShift     PosShift?       @relation("PosReturnRefundShift", fields: [refundShiftId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, saleId, status])
  @@index([organizationId, refundShiftId])
}

/// Credentials are always stored as authenticated ciphertext. The plaintext
/// is accepted only at the adapter boundary and is never returned by an API.
model CarrierAccount {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @db.Uuid
  carrierKey           String               @db.VarChar(80)
  displayName          String               @db.VarChar(160)
  environment          CarrierEnvironment
  externalAccountId    String?              @db.VarChar(160)
  credentialCiphertext String?
  credentialVersion    Int                  @default(1)
  status               CarrierAccountStatus @default(INACTIVE)
  defaultLabelFormat   ShipmentLabelFormat  @default(PDF)
  defaultLabelWidthMm  Int                  @default(101)
  defaultLabelHeightMm Int                  @default(152)
  createdByUserId      String               @db.Uuid
  updatedByUserId      String               @db.Uuid
  createdAt            DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, carrierKey, environment])
  @@index([organizationId, carrierKey, status])
}

model Shipment {
  id                     String         @id @default(uuid()) @db.Uuid
  organizationId         String         @db.Uuid
  carrierAccountId       String         @db.Uuid
  sourceInvoiceId        String?        @db.Uuid
  sourceSaleId           String?        @db.Uuid
  status                 ShipmentStatus @default(DRAFT)
  purchaseIdempotencyKey String         @unique @db.VarChar(220)
  version                Int            @default(1)
  serviceCode            String?        @db.VarChar(80)
  serviceName            String?        @db.VarChar(160)
  quotedCostMinor        BigInt?
  quotedCurrency         String?        @db.Char(3)
  purchasedCostMinor     BigInt?
  purchasedCurrency      String?        @db.Char(3)
  providerShipmentId     String?        @db.VarChar(160)
  trackingNumber         String?        @db.VarChar(160)
  originAddress          Json
  destinationAddress     Json
  customsDeclaration     Json?
  shippingExpenseId      String?        @unique @db.Uuid
  reconcileRequired      Boolean        @default(false)
  lastProviderCode       String?        @db.VarChar(120)
  lastErrorMessage       String?        @db.VarChar(500)
  lastProviderCheckAt    DateTime?      @db.Timestamptz(6)
  purchasedAt            DateTime?      @db.Timestamptz(6)
  voidedAt               DateTime?      @db.Timestamptz(6)
  createdByUserId        String         @db.Uuid
  updatedByUserId        String         @db.Uuid
  createdAt              DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt

  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, sourceInvoiceId])
  @@index([organizationId, sourceSaleId])
  @@index([organizationId, trackingNumber])
}

model ShipmentParcel {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  shipmentId         String              @db.Uuid
  parcelNumber       Int
  weightGrams        Int
  lengthMm           Int
  widthMm            Int
  heightMm           Int
  packageType        String?             @db.VarChar(80)
  labelFormat        ShipmentLabelFormat
  declaredValueMinor BigInt?
  declaredCurrency   String?             @db.Char(3)
  customsLines       Json?
  providerParcelId   String?             @db.VarChar(160)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)

  @@unique([shipmentId, parcelNumber])
  @@unique([organizationId, id])
  @@index([organizationId, shipmentId])
}

model ShipmentLabel {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @db.Uuid
  shipmentId      String              @db.Uuid
  parcelId        String?             @db.Uuid
  format          ShipmentLabelFormat
  mediaType       String              @db.VarChar(100)
  storageKey      String              @db.VarChar(300)
  contentHash     String              @db.Char(64)
  byteSize        Int
  providerLabelId String?             @db.VarChar(160)
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@unique([organizationId, storageKey])
  @@index([organizationId, shipmentId, createdAt])
}

model TrackingEvent {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  shipmentId      String   @db.Uuid
  externalEventId String?  @db.VarChar(160)
  eventHash       String   @db.Char(64)
  status          String   @db.VarChar(80)
  description     String?  @db.VarChar(500)
  location        String?  @db.VarChar(200)
  occurredAt      DateTime @db.Timestamptz(6)
  metadata        Json?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@unique([shipmentId, eventHash])
  @@unique([organizationId, id])
  @@index([organizationId, shipmentId, occurredAt])
}

model ShipmentVoidAttempt {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @db.Uuid
  shipmentId      String             @db.Uuid
  status          ShipmentVoidStatus
  providerCode    String?            @db.VarChar(120)
  responseMessage String?            @db.VarChar(500)
  attemptedAt     DateTime           @default(now()) @db.Timestamptz(6)
  completedAt     DateTime?          @db.Timestamptz(6)
  createdByUserId String             @db.Uuid

  @@unique([organizationId, id])
  @@index([organizationId, shipmentId, attemptedAt])
}

model ShipmentInventoryMovement {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @db.Uuid
  shipmentId          String   @db.Uuid
  inventoryMovementId String   @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  @@unique([shipmentId, inventoryMovementId])
  @@unique([organizationId, id])
  @@index([organizationId, inventoryMovementId])
}
