/// OAuth credentials are encrypted at rest and never leave the API after the provider callback.
model EmailConnection {
  id                   String                  @id @default(uuid()) @db.Uuid
  organizationId       String                  @db.Uuid
  provider             EmailConnectionProvider
  status               EmailConnectionStatus   @default(PENDING)
  senderEmail          String?
  displayName          String?
  grantedScopes        String[]                @default([])
  credentialCiphertext String?
  credentialVersion    Int                     @default(1)
  tokenExpiresAt       DateTime?               @db.Timestamptz(6)
  isDefaultSender      Boolean                 @default(false)
  lastErrorCode        String?
  connectedAt          DateTime?               @db.Timestamptz(6)
  disconnectedAt       DateTime?               @db.Timestamptz(6)
  updatedByUserId      String                  @db.Uuid
  createdAt            DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, isDefaultSender])
}

/// Short-lived, single-use authorization attempts. State is stored only as a hash and the PKCE
/// verifier is encrypted; neither value is returned by normal API reads or audit records.
model EmailOAuthAttempt {
  id                     String                  @id @default(uuid()) @db.Uuid
  organizationId         String                  @db.Uuid
  provider               EmailConnectionProvider
  userId                 String                  @db.Uuid
  stateHash              String                  @db.Char(64)
  codeVerifierCiphertext String
  redirectUri            String
  expiresAt              DateTime                @db.Timestamptz(6)
  consumedAt             DateTime?               @db.Timestamptz(6)
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, stateHash])
  @@index([organizationId, provider, expiresAt])
}

