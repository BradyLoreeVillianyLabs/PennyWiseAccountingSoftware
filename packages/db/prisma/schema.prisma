// A provider Item is deliberately separate from a local account mapping: one
// consented connection can expose several accounts, while each PennyWise
// account can have at most one active connected source. Provider access tokens
// are encrypted server-side and are never returned through the API.
model BankFeedItem {
  id                    String                    @id @default(uuid()) @db.Uuid
  organizationId        String                    @db.Uuid
  providerKey           String                    @db.VarChar(40)
  providerItemReference String                    @db.VarChar(240)
  credentialCiphertext  String
  credentialVersion     Int                       @default(1)
  institutionReference  String?                   @db.VarChar(240)
  institutionName       String?                   @db.VarChar(240)
  consentedAt           DateTime                  @db.Timestamptz(6)
  consentExpiresAt      DateTime?                 @db.Timestamptz(6)
  status                BankFeedItemStatus        @default(READY)
  lastCursor            String?
  lastSyncAt            DateTime?                 @db.Timestamptz(6)
  lastErrorRedacted     String?
  createdByUserId       String                    @db.Uuid
  updatedByUserId       String                    @db.Uuid
  createdAt             DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountMappings       BankFeedAccountMapping[]
  syncs                 BankFeedSync[]
  importedTransactions  BankImportedTransaction[] @relation("BankFeedImportedTransactions")

  @@unique([organizationId, providerKey, providerItemReference])
  @@unique([organizationId, id])
  @@index([organizationId, status])
}

