/// Explicit intercompany evidence. This record does not post a journal by
/// itself; a future approved workflow must create linked balanced journals via
/// JournalService and retain the posting IDs here.
model IntercompanyTransaction {
  id               String                        @id @default(uuid()) @db.Uuid
  organizationId   String                        @db.Uuid
  fromCompanyId    String                        @db.Uuid
  toCompanyId      String                        @db.Uuid
  status           IntercompanyTransactionStatus @default(DRAFT)
  amountMinor      BigInt
  currency         String                        @db.Char(3)
  effectiveDate    DateTime                      @db.Date
  sourceType       String
  sourceId         String
  description      String
  balanceEvidence  Json?
  fromJournalId    String?                       @db.Uuid
  toJournalId      String?                       @db.Uuid
  createdByUserId  String                        @db.Uuid
  approvedByUserId String?                       @db.Uuid
  createdAt        DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                      @updatedAt
  organization     Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromCompany      Company                       @relation("IntercompanyFromCompany", fields: [fromCompanyId], references: [id], onDelete: Restrict)
  toCompany        Company                       @relation("IntercompanyToCompany", fields: [toCompanyId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, sourceType, sourceId])
  @@index([organizationId, status, effectiveDate])
  @@index([fromCompanyId, status])
  @@index([toCompanyId, status])
}

