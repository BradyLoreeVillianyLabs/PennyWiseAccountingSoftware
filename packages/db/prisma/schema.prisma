generator client {
  provider = "prisma-client-js"
  output   = "../generated-client"
}

// The runtime client is intentionally separate while the application completes
// its D5 compatibility transition. Keep it generated from this exact schema:
// it executes production queries and must never lag behind the public client.
generator runtime {
  provider = "prisma-client-js"
  output   = "../generated-client-d5"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

